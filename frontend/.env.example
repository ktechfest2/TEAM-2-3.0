# VeriVote Nigeria - frontend environment template.
# Copy to `.env.local` and fill in values. Never commit real values.
#
# Every VITE_* variable is embedded into the public JavaScript bundle.
# Only put values here that are safe for anyone on the internet to read.
# NEVER put the Supabase service-role key, database URL or JWT secret here.

# Base URL of the VeriVote FastAPI backend (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase project URL and *anon/publishable* key (public by design; RLS protects data).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Deployment label shown in the UI: development | staging | production
VITE_APP_ENV=development

# Development only: lets you preview the admin shell without Supabase.
# Ignored in production builds. The backend still rejects all admin API calls.
VITE_ENABLE_ADMIN_PREVIEW=false

# Public origin of the site, for example https://verivote.example.ng (no trailing slash).
# When set, the build writes sitemap.xml and links it from robots.txt.
VITE_SITE_URL=
