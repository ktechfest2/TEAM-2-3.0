# VeriVote Nigeria API. Copy to backend/.env and fill in real values.
# Never commit backend/.env. Never put these values in any VITE_ variable.

# development | test | staging | production
# Production refuses to start unless DATABASE_URL, AUTH_JWT_SECRET,
# CORS_ORIGINS, EVIDENCE_STORAGE=supabase, SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY are all set.
APP_ENV=development
LOG_LEVEL=INFO
APP_VERSION=0.1.0

API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated browser origins. Never use "*".
CORS_ORIGINS=http://localhost:5173

# Polling-unit directory, elections and updates.
# database = register imported by administrators (admin console or
#            python -m app.directory.import_csv), stored with the evidence data
# demo     = fictional, clearly labelled dataset for tests; refused in production
DIRECTORY_SOURCE=database

# Requests per minute per client on /api/v1 (0 disables). In-process only:
# also rate-limit at the proxy or CDN in deployed environments.
RATE_LIMIT_PER_MINUTE=120
# Only set true behind a proxy you control that overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Postgres connection for the API. Use the dedicated database role, not the
# Supabase service role. postgresql:// and postgres:// are rewritten to the
# psycopg driver. Require TLS when the host is not local.
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Supabase project URL (server-side). Not a secret, but unused by the browser.
SUPABASE_URL=

# --- Staff sign-in -----------------------------------------------------------
# Built-in accounts (email and password stored hashed with scrypt in our own DB).
# Create the first administrator with:
#   .venv/bin/python -m app.auth.create_admin --email you@example.org --name "Your Name"
# Signing secret for VeriVote session tokens, at least 32 characters.
# Generate with: openssl rand -hex 32. In development a random secret is created
# in var/auth-secret when this is empty; production requires it.
AUTH_JWT_SECRET=
AUTH_TOKEN_MINUTES=480
# Failed passwords before an account is locked, and for how long.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Optional: also accept Supabase access tokens (Project Settings → API → JWT Secret).
# HS256 shared secret, at least 32 characters.
SUPABASE_JWT_SECRET=

# Server only. Used by the API to read and write the private evidence bucket.
# Never expose it to the frontend or put it in any VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# --- Evidence capture and verification -------------------------------------
# local    = private directory on this machine (development and tests only)
# supabase = private Supabase Storage bucket (required in production)
EVIDENCE_STORAGE=local
EVIDENCE_LOCAL_DIR=var/evidence
# Create this bucket as PRIVATE. Never make it public.
EVIDENCE_BUCKET=evidence
# Evidence records use this SQLite file when DATABASE_URL is empty
# (development and test only; production requires Postgres).
DEV_DATABASE_PATH=var/dev-evidence.sqlite3

# Upload limits.
EVIDENCE_MAX_BYTES=15728640
EVIDENCE_MIN_DIMENSION=500
EVIDENCE_MAX_DIMENSION=12000
# Accepted submissions per user, per election and polling unit.
EVIDENCE_MAX_PER_POLLING_UNIT=3

# auto      = Tesseract if its binary is installed, otherwise RapidOCR if installed
# tesseract = requires the Tesseract binary on the server (apt install tesseract-ocr)
# rapidocr  = pure-Python engine; install with requirements-ocr.txt (see that file)
# none      = OCR disabled; every field is transcribed manually
# If the chosen engine is missing, processing falls back to manual transcription.
OCR_PROVIDER=auto
# Fields below this confidence (0-1) are flagged for human confirmation.
OCR_CONFIDENCE_THRESHOLD=0.85

# Distinct reviewer approvals of the same result fingerprint needed for VERIFIED.
VERIFICATION_REQUIRED_APPROVALS=2
# Human-reviewed records required before statistical anomaly analysis runs.
ANOMALY_MIN_SAMPLES=30

# --- Incident reports --------------------------------------------------------
# Submissions per client address per hour (0 disables). Counted in memory only;
# the address is never stored with a report. Run Uvicorn with --no-access-log so
# the server's own access log does not record client IPs either.
INCIDENT_SUBMISSIONS_PER_HOUR=10
INCIDENT_ATTACHMENT_MAX_BYTES=8388608
INCIDENT_ATTACHMENT_MIN_DIMENSION=200
# Reports in the same area and category within this window are compared.
INCIDENT_SIMILARITY_WINDOW_HOURS=6

# --- USSD and SMS ------------------------------------------------------------
# No shortcode is allocated in this repository. Real phones need an Africa's
# Talking account (or another gateway that can sign callbacks), see
# docs/incidents-and-channels.md.
# Simulator mode accepts unsigned requests. Defaults to on outside production;
# production refuses to start while it is on.
# CHANNEL_SIMULATOR_ENABLED=true
# Gateways sign callbacks as X-VeriVote-Signature: sha256=<HMAC-SHA256 of the raw body>.
# At least 32 characters each. Generate with: openssl rand -hex 32
USSD_WEBHOOK_SECRET=
SMS_WEBHOOK_SECRET=
# Key for hashing phone numbers. Required when either webhook secret is set.
CHANNEL_HASH_SECRET=
# Election answered by USSD and SMS. Empty means the latest election in the directory.
CHANNEL_ELECTION_ID=

# Africa's Talking. It cannot sign callbacks, so register callback URLs that
# carry this token (at least 32 characters, openssl rand -hex 32):
#   USSD: https://<public-host>/api/v1/ussd/gateway?token=<CHANNEL_CALLBACK_TOKEN>
#   SMS:  https://<public-host>/api/v1/sms/africastalking?token=<CHANNEL_CALLBACK_TOKEN>
CHANNEL_CALLBACK_TOKEN=
# sandbox uses username "sandbox" and the simulator at simulator.africastalking.com.
AFRICASTALKING_ENVIRONMENT=sandbox
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# Your allocated shortcode or approved alphanumeric sender ID. Empty uses the default.
AFRICASTALKING_SENDER_ID=

USSD_SESSION_TIMEOUT_SECONDS=180
SMS_MESSAGES_PER_WINDOW=10
SMS_WINDOW_SECONDS=600
